            "state" : "translated",
            "value" : "Notifiche"
          }
        }
      }
    },
    "Notifications appear only while the app is in the background. The Mac never sleeps during a revive or a restore." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche compaiono solo quando l’app è in secondo piano. Il Mac non va mai in stop durante una riattivazione o un ripristino."
          }
        }
      }
    },
    "Notifications are the only consent macOS asks for. The administrator password is requested each time a command is sent." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono l’unico consenso che macOS richiede. La password di amministratore viene chiesta ogni volta che si invia un comando."
          }
        }
      }
    },
    "Notify when a revive or a restore ends" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa quando finisce una riattivazione o un ripristino"
          }
        }
      }
