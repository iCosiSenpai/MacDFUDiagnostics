{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ couldn't be ejected. Close the files that are in use and try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile espellere %@. Chiudi i file in uso e riprova."
          }
        }
      }
    },
    "%@ ejected. It is safe to disconnect." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ espulso. Puoi scollegare il cavo."
          }
        }
      }
    },
    "%@ has problems." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ presenta problemi."
          }
        }
      }
    },
    "%@ is ready in DFU." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è pronto in DFU."
          }
