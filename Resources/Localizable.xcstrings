    "A Mac is being revived or restored." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso la riattivazione o il ripristino di un Mac."
          }
        }
      }
    },
    "A Mac stopped half-way may not start until it is restored." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Mac interrotto a metà potrebbe non avviarsi finché non viene ripristinato."
