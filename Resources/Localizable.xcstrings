    "Apple silicon: after about 10 seconds release the three keys, and keep holding power for up to 10 more." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip Apple: dopo circa 10 secondi rilascia i tre tasti e continua a tenere premuto il tasto di accensione per altri 10 al massimo."
          }
        }
      }
    },
